        <div class="form-card">
            <h2 style="color:#b45f2b; margin-bottom:0.8rem; display:flex; gap:8px;"><i class="fas fa-pencil-alt"></i> Formulário de Voluntariado</h2>
            <p style="margin-bottom: 1.8rem; font-size:0.9rem;">Preencha os dados e escolha como quer ajudar nos dias da festa junina! 🧡</p>
            
            <form id="volunteerForm">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Nome completo <span class="required-star">*</span></label>
                    <input type="text" id="nome" placeholder="Seu nome completo" required>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-envelope"></i> E-mail <span class="required-star">*</span></label>
                    <input type="email" id="email" placeholder="voce@email.com" required>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-phone-alt"></i> Telefone / WhatsApp</label>
                    <input type="tel" id="telefone" placeholder="(11) 99999-9999">
                </div>

                <!-- Disponibilidade (turnos) -->
                <div class="form-group">
                    <div class="checkbox-title"><i class="fas fa-clock"></i> 🔔 Disponibilidade (selecione pelo menos um turno) <span class="required-star">*</span></div>
                    <div class="checkbox-group">
