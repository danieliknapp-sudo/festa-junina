<script>
    (function() {
        const form = document.getElementById('volunteerForm');
        const messageDiv = document.getElementById('formMessage');

        // helpers
        function showMessage(text, isError = false) {
            messageDiv.textContent = text;
            messageDiv.className = 'message-area';
            if (isError) {
                messageDiv.classList.add('error');
            } else {
                messageDiv.classList.add('success');
            }
            // scroll suave para a mensagem
            messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function clearMessage() {
            messageDiv.className = 'message-area';
            messageDiv.textContent = '';
            messageDiv.style.display = 'none';
            // força display none no next reset
        }

        // validação dos checkboxes (pelo menos um)
        function isAtLeastOneChecked(checkboxGroupName) {
            const checkboxes = document.querySelectorAll(`input[name="${checkboxGroupName}"]`);
            for (let cb of checkboxes) {
                if (cb.checked) return true;
            }
            return false;
        }

        function validateEmail(email) {
            const re = /^[^\s@]+@([^\s@.,]+\.)+[^\s@.,]{2,}$/;
            return re.test(email);
        }

        function resetFormFields() {
            form.reset();   // limpa todos os campos, checkboxes e textos
            // após reset, qualquer mensagem de erro some
        }

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            clearMessage();

            // 1. Nome
            const nome = document.getElementById('nome').value.trim();
            if (nome === "") {
                showMessage("❌ Por favor, digite seu nome completo.", true);
                return;
            }

            // 2. Email
            const email = document.getElementById('email').value.trim();
            if (email === "") {
                showMessage("📧 O e-mail é obrigatório para contato.", true);
                return;
            }
            if (!validateEmail(email)) {
                showMessage("⚠️ E-mail inválido! Exemplo: nome@provedor.com", true);
                return;
            }

            // 3. Disponibilidade pelo menos 1
            const temDisponibilidade = isAtLeastOneChecked('disponibilidade');
            if (!temDisponibilidade) {
                showMessage("🗓️ Selecione pelo menos um turno de disponibilidade (Sábado ou Domingo).", true);
                return;
            }

            // 4. Atividades pelo menos 1
            const temAtividade = isAtLeastOneChecked('atividade');
            if (!temAtividade) {
                showMessage("🎪 Escolha ao menos uma área onde deseja ajudar!", true);
                return;
            }

            // (opcional) pegar valores só para debug / simulação
            const disponibilidadeSelecionada = Array.from(document.querySelectorAll('input[name="disponibilidade"]:checked')).map(cb => cb.value);
            const atividadesSelecionadas = Array.from(document.querySelectorAll('input[name="atividade"]:checked')).map(cb => cb.value);
            const telefone = document.getElementById('telefone').value.trim();
            const observacoes = document.querySelector('textarea').value.trim();

            // SIMULAÇÃO DE ENVIO (sucesso)
            // Mostra mensagem de sucesso com detalhes amigáveis
            let turnosTexto = disponibilidadeSelecionada.join(', ');
            let areasTexto = atividadesSelecionadas.join(', ');
            showMessage(`✨ Obrigado, ${nome}! ✨ Sua inscrição foi recebida com sucesso. Você ajudará nos turnos: ${turnosTexto} | Áreas: ${areasTexto}. A equipe da Escola Rocha Pombo enviará um e-mail em breve. Viva São João! 🎏`, false);
            
            // Limpa o formulário após sucesso para permitir nova inscrição (de outra pessoa)
            // Pequeno delay para o usuário visualizar a mensagem antes do reset (opcional, mas mais fluido)
            setTimeout(() => {
                resetFormFields();
                // após reset, limpar a área de mensagem mantendo o sucesso visível por mais alguns segundos?
                // Não vamos sobrepor a mensagem de sucesso para não confundir. Reset mantém os campos vazios mas a mensagem continua.
                // O usuário pode ver os dados enviados, e se quiser inscrever outra pessoa, o formulário já está limpo.
                // garantindo que a mensagem de sucesso permaneça até outra submissão.
            }, 50);
        });
    })();
</script>
</body>
</html>
```